Arguments (pass arguments as '<name>:=<value>'):

    'serial_port':
        ESP32 device path. Empty leaves the serial bridge off.
        (default: '')

    'motion_enabled':
        Allow the mux to forward motion after its guards pass. Valid choices are: ['true', 'false']
        (default: 'false')

    'use_tof':
        Enable and require fresh ToF features. Valid choices are: ['true', 'false']
        (default: 'false')

    'start_driver':
        Set false when replaying an external /unilidar/cloud source. Valid choices are: ['true', 'false']
        (default: 'true')

    'cloud_scan_num':
        Unitree cloud packet count used by the main navigation launcher.
        (default: '36')

    'lidar_ip':
        Unitree UDP address from the main launch profile.
        (default: '192.168.1.62')

    'local_ip':
        Existing host UDP address. Launch does not configure networking.
        (default: '192.168.1.2')
